@model FinancePlanner.ViewModels.InvestmentViewModel

@{
    ViewData["Title"] = "Delete Investment";
}

<h1>Delete Investment</h1>

<h3>Are you sure you want to delete this?</h3>

<div>
    <h4>Investment</h4>
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model.Description</dd>

        <dt class="col-sm-2">Type</dt>
        <dd class="col-sm-10">@Model.Type</dd>

        <dt class="col-sm-2">Quantity</dt>
        <dd class="col-sm-10">@Model.Quantity</dd>

        <dt class="col-sm-2">Cost</dt>
        <dd class="col-sm-10">@Model.Cost</dd>

        @if (Model.Recurring)
        {
            <dt class="col-sm-2">Frequency</dt>
            <dd class="col-sm-10">@Model.Frequency</dd>

            <dt class="col-sm-2">Start Date</dt>
            <dd class="col-sm-10">@(Model.StartDate?.ToString("d") ?? "—")</dd>

            <dt class="col-sm-2">End Date</dt>
            <dd class="col-sm-10">@(Model.EndDate?.ToString("d") ?? "—")</dd>
        }
    </dl>
</div>

<form asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ID" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
