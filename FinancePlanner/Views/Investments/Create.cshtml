@using FinancePlanner.Models.Investment
@using FinancePlanner.ViewModels
@model InvestmentViewModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Investment</h4>
<hr/>
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control"/>
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <input asp-for="Description" class="form-control"/>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Type" class="control-label"></label>
                <select asp-for="Type" asp-items="Html.GetEnumSelectList<InvestmentType>()"
                        class="form-control"></select>
                <span asp-validation-for="Type" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PingItem" class="control-label"></label>
                <select asp-for="PingItem" asp-items="Html.GetEnumSelectList<InvestmentType>()"
                        class="form-control"></select>
                <span asp-validation-for="PingItem" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Quantity" class="control-label"></label>
                <input asp-for="Quantity" class="form-control"/>
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Cost" class="control-label"></label>
                <input asp-for="Cost" class="form-control" min="0" value=""/>
                <span asp-validation-for="Cost" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Recurring" class="control-label"></label>
                <input asp-for="Recurring"/>
                <span asp-validation-for="Recurring" class="text-danger"></span>
            </div>
            <div id="recurringFields" style="display:@(Model.Recurring ? "block" : "none")">
                <div class="form-group">
                    <label asp-for="Frequency" class="control-label"></label>
                    <select asp-for="Frequency" asp-items="Html.GetEnumSelectList<FrequencyType>()"
                            class="form-control"></select>
                    <span asp-validation-for="Frequency" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="StartDate" class="control-label"></label>
                    <input asp-for="StartDate" class="form-control"/>
                    <span asp-validation-for="StartDate" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="EndDate" class="control-label"></label>
                    <input asp-for="EndDate" class="form-control"/>
                    <span asp-validation-for="EndDate" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary"/>
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        document.getElementById('Recurring').addEventListener('change', function () {
            var recurringFields = document.getElementById('recurringFields');
            if (this.checked) {
                recurringFields.style.display = 'block';
            } else {
                recurringFields.style.display = 'none';
            }
        });

        document.getElementById('Type').addEventListener('change', function () {
            if (this.value === 1) {
                recurringFields.style.display = 'block';
            } else {
                recurringFields.style.display = 'none';
            }
        });

    </script>
}
