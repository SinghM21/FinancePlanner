@model FinancePlanner.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4" style="margin-bottom: 20px;">Welcome to your financial future</h1>
</div>

<div class="row">
    <div class="col">
        <div class="card" style="width: 18rem;">
            <div class="card-body">
                <h5 class="card-title">Income</h5>
                <p>@Model.CurrentIncome</p>
            </div>
        </div>
    </div>

    <div class="col">
        <div class="card" style="width: 18rem;">
            <div class="card-body">
                <h5 class="card-title">Expenses</h5>
                <p>@Model.CurrentOutcome</p>
            </div>
        </div>
    </div>

    <div class="col">
        <div class="card" style="width: 18rem;">
            <div class="card-body">
                <h5 class="card-title">Remaining</h5>
                <p>@Model.NetIncome</p>
            </div>
        </div>
    </div>

    <div class="col">
        <div class="card" style="width: 18rem;">
            <div class="card-body">
                <h5 class="card-title">Goal</h5>
                <p id="goalDisplay"></p>
                <select id="goalSelect" class="form-select">
                    <option value="">Select a goal</option>
                    <option value="budget">Budget</option>
                    <option value="invest">Invest</option>
                    <option value="save">Save</option>
                </select>
            </div>
        </div>
    </div>
</div>
<hr/>
<div class="row">
    <ul class="nav nav-tabs" id="myTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="projection-tab" data-bs-toggle="tab"
                    data-bs-target="#projection-tab-pane" type="button" role="tab" aria-controls="projection-tab-pane"
                    aria-selected="true">Projection
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="second-tab" data-bs-toggle="tab" data-bs-target="#second-tab-pane"
                    type="button" role="tab" aria-controls="second-tab-pane" aria-selected="false">Cashflow
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="third-tab" data-bs-toggle="tab" data-bs-target="#third-tab-pane" type="button"
                    role="tab" aria-controls="third-tab-pane" aria-selected="false">Spending
            </button>
        </li>

    </ul>
    <div class="tab-content" id="myTabContent" style="height: 470px;">
        <div class="tab-pane fade show active" id="projection-tab-pane" role="tabpanel" aria-labelledby="projection-tab"
             tabindex="0">
            <div class="row">
                <div class="col-md-9" style="height: 400px;">
                    <canvas id="myChart"></canvas>
                </div>

                <div class="col-md-3">
                    <div class=card>
                        <div class="card-body">
                            <h5 class="card-title">Projection Settings</h5>
                        </div>
                    </div>
                </div>
            </div>
            @using (Html.BeginForm("Index", "Home", FormMethod.Post))
            {
                <div>
                    <label>Expected Income Increase:</label>
                    <input type="number" id="IncomeProjectionIncreaseNumber"
                           name="IncomeProjectionIncreaseNumber"
                           min="0"
                           max="100"/>
                    <br/>
                    <label>Expected Outcome Increase:</label>
                    <input type="number" id="OutcomeProjectionIncreaseNumber"
                           name="OutcomeProjectionIncreaseNumber"
                           min="0"
                           max="100"/>
                    <input type="submit"/>
                </div>
            }
        </div>
        <div class="tab-pane fade" id="second-tab-pane" role="tabpanel" aria-labelledby="second-tab" tabindex="0">..
        </div>
        <div class="tab-pane fade" id="third-tab-pane" role="tabpanel" aria-labelledby="third-tab" tabindex="0">...
        </div>
    </div>
</div>
<hr/>
<div class="row">
    <div class="col">
        Column
    </div>
    <div class="col">
        Column
    </div>
    <div class="col">
        Column
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const ctx = document.getElementById('myChart');
        var min = new Date().getFullYear()
        var max = min + 10
        var years = []

        for (var i = min; i <= max; i++) {
            years.push(i)
        }

        const labels = years;
        var incomesArray = [];
        var outcomesArray = [];

        @foreach (var income in Model.YearlyIncome)
        {
            @:incomesArray.push("@income");
        }

        @foreach (var outcome in Model.YearlyOutcome)
        {
            @:outcomesArray.push("@outcome");
        }

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Income',
                    data: incomesArray,
                    fill: false,
                    borderColor: 'rgb(75, 192, 192)',
                    tension: 0.1
                },
                    {
                        label: 'Outcome',
                        data: outcomesArray,
                        fill: false,
                        borderColor: 'rgb(255, 0, 0)',
                        tension: 0.1
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    title: {
                        display: true,
                        text: '10 Year Portfolio Projection'
                    }
                },
                scales: {
                    y: {}
                }
            }
        });
    });
</script>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const goalSelect = document.getElementById('goalSelect');
        const savedUserGoal = localStorage.getItem('userGoal');
        if (savedUserGoal) {
            goalSelect.value = savedUserGoal;
        }

        goalSelect.addEventListener('change', () => {
            const goalVal = goalSelect.value;
            localStorage.setItem('userGoal', goalVal);
        });
    });
</script>
