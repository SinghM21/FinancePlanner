@model FinancePlanner.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome to your financial future</h1>

</div>

<div class="row">
    <div class="col-md-10">
        <canvas id="myChart"></canvas>
    </div>
</div>

@using (Html.BeginForm("Index", "Home", FormMethod.Post))
{
    <div>
        <label>Expected Income Increase:</label>
        <input type="number" id="IncomeProjectionIncreaseNumber" name="IncomeProjectionIncreaseNumber" min="0" max="100" />
        <br />
        <label>Expected Outcome Increase:</label>
        <input type="number" id="OutcomeProjectionIncreaseNumber" name="OutcomeProjectionIncreaseNumber" min="0" max="100" />
        <input type="submit" />
    </div>
}

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const ctx = document.getElementById('myChart');
    var min = new Date().getFullYear()
    var max = min + 10
    var years = []

    for (var i = min; i <= max; i++) {
      years.push(i)
    }

    const labels = years;
    var incomesArray = [];
    var outcomesArray =[];

    @foreach (var income in Model.yearlyIncome)
    {
        @:incomesArray.push("@income");
    }

    @foreach (var outcome in Model.yearlyOutcome)
    {
        @:outcomesArray.push("@outcome");
    }

    new Chart(ctx, {
        type: 'line',
        data: {
            labels: labels,
            datasets: [{
                label: 'Income',
                data: incomesArray,
                fill: false,
                borderColor: 'rgb(75, 192, 192)',
                tension: 0.1
            },
            {
                label: 'Outcome',
                data: outcomesArray,
                fill: false,
                borderColor: 'rgb(255, 0, 0)',
                tension: 0.1
            }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                title: {
                    display: true,
                    text: '10 Year Portfolio Projection'
                }
            },
            scales: {
                y: {
                }
            }
        }
    });
</script>
