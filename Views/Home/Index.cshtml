@model FinancePlanner.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome to your financial future</h1>

</div>

<div class="row">
    <div class="col-md-10">
        <canvas id="myChart"></canvas>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const ctx = document.getElementById('myChart');
    var min = new Date().getFullYear()
    var max = min + 10
    var years = []

    for (var i = min; i <= max; i++) {
      years.push(i)
    }

    const labels = years;

    var data1 = @Html.Raw(Model.monthlyIncome);
    var data3 = @Html.Raw(Model.monthlyOutcome);

    new Chart(ctx, {
        type: 'line',
        data: {
            labels: labels,
            datasets: [{
                label: 'Income',
                data: [data1],
                fill: false,
                borderColor: 'rgb(75, 192, 192)',
                tension: 0.1
            },
            {
                label: 'Outcome',
                data: [data3],
                fill: false,
                borderColor: 'rgb(255, 0, 0)',
                tension: 0.1
            }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                title: {
                    display: true,
                    text: '10 Year Portfolio Projection'
                }
            },
            scales: {
                y: {
                }
            }
        }
    });
</script>
